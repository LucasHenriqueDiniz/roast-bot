{
  "compilerOptions": {
    "rootDir": "./src",
    "module": "nodenext",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "better-sqlite3"]
  },
  "include": ["src"]
}
